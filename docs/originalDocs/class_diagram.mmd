classDiagram
    %% UI Layer
    class MainActivity {
        +onCreate()
    }

    class AppNavigation {
        +authRepository: AuthRepository
        +firestoreClient: FirestoreClient
        +navController: NavController
    }

    class DashboardScreen {
        +onLogout()
        +onNavigateToScan()
        +firestoreClient: FirestoreClient
        +userId: String
    }

    class ScanScreen {
        +onNavigateBack()
        +firestoreClient: FirestoreClient
        +userId: String
        +viewModel: ScanViewModel
    }

    class OnboardingScreen
    class GoalsScreen
    class DietaryScreen
    class LoginScreen
    class RegisterScreen
    class WelcomeScreen

    %% ViewModels
    class ScanViewModel {
        -firestoreClient: FirestoreClient
        -userId: String
        -userAllergens: List~String~
        +uiState: StateFlow~ScanUiState~
        +bindCamera()
        +captureAndScan()
        +saveLog(label, productName)
        +resetToIdle()
    }

    class ScanViewModelFactory {
        +create()
    }

    class OnboardingViewModel {
        +buildDietary()
    }

    %% Business Logic
    class NutritionParser {
        +parse(rawText: String) NutritionLabel
    }

    class DietAnalyzer {
        +analyze(label, goals, allergens) FitResult
    }

    %% Data Layer
    class AuthRepository {
        +currentUser: FirebaseUser
        +uid: String
        +login()
        +register()
        +logout()
    }

    class FirestoreClient {
        +insertUser()
        +getUser()
        +insertDietary()
        +getAllergensByUserId()
        +insertNutritionLog()
        +getWeeklyLogs()
        +getDailyLogs()
    }

    %% Models
    class User {
        +userId: String
        +firstName: String
        +lastName: String
        +email: String
    }

    class Dietary {
        +dietaryId: String
        +userId: String
        +age: Int
        +weight: Int
        +activityLevel: Int
        +goals: List~String~
        +allergens: List~String~
        +diets: List~String~
    }

    class NutritionLog {
        +logId: String
        +userId: String
        +productName: String
        +calories: Int
        +proteinG: Int
        +carbsG: Int
        +fatG: Int
        +sugarG: Int
        +waterMl: Int
        +timestamp: Long
    }

    class NutritionLabel {
        +calories: Int
        +proteinG: Int
        +carbsG: Int
        +fatG: Int
        +sugarG: Int
        +waterMl: Int
        +servingSize: String
        +rawText: String
    }

    class FitResult {
        +fitsInDiet: Boolean
        +remainingCalories: Int
        +remainingProteinG: Int
        +remainingCarbsG: Int
        +remainingFatG: Int
        +message: String
        +allergenWarnings: List~String~
    }

    class UserGoals {
        +dailyCalories: Int
        +dailyProteinG: Int
        +dailyCarbsG: Int
        +dailyFatG: Int
    }

    %% Relationships
    MainActivity --> AppNavigation : hosts
    AppNavigation --> DashboardScreen : navigates to
    AppNavigation --> ScanScreen : navigates to
    AppNavigation --> LoginScreen : navigates to
    AppNavigation --> RegisterScreen : navigates to
    AppNavigation --> OnboardingScreen : navigates to
    AppNavigation --> GoalsScreen : navigates to
    AppNavigation --> DietaryScreen : navigates to
    AppNavigation --> WelcomeScreen : navigates to
    AppNavigation --> AuthRepository : uses
    AppNavigation --> FirestoreClient : uses

    ScanScreen --> ScanViewModel : uses
    ScanViewModelFactory --> ScanViewModel : creates
    ScanViewModel --> FirestoreClient : uses
    ScanViewModel --> NutritionParser : uses
    ScanViewModel --> DietAnalyzer : uses

    DietaryScreen --> OnboardingViewModel : uses
    DietaryScreen --> FirestoreClient : uses

    DashboardScreen --> FirestoreClient : fetches logs

    NutritionParser ..> NutritionLabel : creates
    DietAnalyzer ..> FitResult : creates
    DietAnalyzer --> NutritionLabel : analyzes
    DietAnalyzer --> UserGoals : uses

    FirestoreClient ..> User : manages
    FirestoreClient ..> Dietary : manages
    FirestoreClient ..> NutritionLog : manages
    AuthRepository ..> User : authenticates
